<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Créer un compte"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="40dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/identifiant_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Identifiant (min 3 caractères)"
                android:inputType="text"
                android:padding="12dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/edit_text_background" />

            <EditText
                android:id="@+id/email_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/edit_text_background" />

            <EditText
                android:id="@+id/mot_de_passe_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mot de passe (min 8 caractères)"
                android:inputType="textPassword"
                android:padding="12dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/edit_text_background" />

            <EditText
                android:id="@+id/champignon_prefere_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Champignon préféré (optionnel)"
                android:inputType="text"
                android:padding="12dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/edit_text_background" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/register_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="S'inscrire"
        android:textSize="16sp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_primary_background" />

    <Button
        android:id="@+id/back_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Retour à la connexion"
        android:textSize="16sp"
        android:background="@drawable/button_secondary_background" />

</LinearLayout>
