<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/item_bg"
    android:layout_marginBottom="8dp"
    android:padding="10dp">

    <ImageView
        android:id="@+id/historyMushroomImage"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/mushroom_image_bg"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:src="@drawable/ic_mushroom_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/historyMushroomName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/historyMushroomImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/historyMushroomImage"
        app:layout_constraintBottom_toTopOf="@id/historyMeta" />

    <TextView
        android:id="@+id/historyMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@id/historyMushroomImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/historyMushroomName"
        app:layout_constraintBottom_toBottomOf="@id/historyMushroomImage" />

</androidx.constraintlayout.widget.ConstraintLayout>
