<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- What is the color of the cap? -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the color of the cap ?"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_cap_color"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="20dp" />

        <!-- What is the color of the foot ? -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the color of the foot ?"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_foot_color"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="20dp" />

        <!-- What is the color of the veil ? -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the color of the veil ?"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_veil_color"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="20dp" />

        <!-- What is the odor of the mushroom? -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the odor of the mushroom ?"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_odor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="20dp" />

        <!-- What colour has the shroom when broken ? -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What colour has the shroom when broken ?"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_bruises"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="32dp" />

        <!-- Bouton Identify -->
        <TextView
            android:id="@+id/btn_identify_form"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Identify"
            android:textSize="16sp"
            android:textColor="#C98D63"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>