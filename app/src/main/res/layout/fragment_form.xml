<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Cap Shape -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the shape of the cap ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_cap_shape"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Cap Surface -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the surface of the cap ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_cap_surface"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Cap Color -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the color of the cap ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_cap_color"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Bruises -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Does it bruise when touched ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_bruises"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Odor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the odor ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_odor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Gill Attachment -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How are the gills attached ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_gill_attachment"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Gill Spacing -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the gill spacing ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_gill_spacing"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Gill Size -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the gill size ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_gill_size"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Gill Color -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the gill color ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_gill_color"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Stalk Shape -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the shape of the stalk ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_stalk_shape"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Stalk Root -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the stalk root like ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_stalk_root"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Stalk Surface Above Ring -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stalk surface above ring ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_stalk_surface_above"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Stalk Surface Below Ring -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stalk surface below ring ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_stalk_surface_below"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Stalk Color Above Ring (Foot) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the color of the foot ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_stalk_color_above"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Stalk Color Below Ring -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stalk color below ring ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_stalk_color_below"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Veil Type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What type of veil ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_veil_type"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Veil Color -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the color of the veil ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_veil_color"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Ring Number -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How many rings ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_ring_number"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Ring Type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What type of ring ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_ring_type"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Spore Print Color -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the spore print color ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_spore_print_color"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Population -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the population ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_population"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="16dp" />

        <!-- Habitat -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the habitat ?"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_habitat"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:layout_marginBottom="24dp" />

        <!-- Progress Text -->
        <TextView
            android:id="@+id/progress_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Identifying..."
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Identify Button -->
        <TextView
            android:id="@+id/btn_identify_form"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Identify"
            android:textSize="16sp"
            android:textColor="#C98D63"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>