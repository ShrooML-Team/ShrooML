<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#C98D63"
    android:padding="20dp">

    <!-- Titre ShroomML -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ShroomML"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="sans-serif-medium" />

    <!-- ScrollView pour le formulaire -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- What is the color of the cap? -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What is the color of the cap ?"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/spinner_cap_color"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="16dp" />

            <!-- What is the color of the foot ? -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What is the color of the foot ?"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/spinner_foot_color"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="16dp" />

            <!-- What is the color of the veil ? -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What is the color of the veil ?"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/spinner_veil_color"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="16dp" />

            <!-- What is the odor of the mushroom? -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What is the odor of the mushroom ?"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/spinner_odor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="16dp" />

            <!-- What colour has the shroom when broken ? -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What colour has the shroom when broken ?"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/spinner_bruises"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="32dp" />

            <!-- Bouton Identify du formulaire -->
            <TextView
                android:id="@+id/btn_identify_form"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Identify"
                android:textSize="16sp"
                android:textColor="#C98D63"
                android:gravity="center"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Boutons de navigation : Ranking | Identify | Games -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/btn_ranking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ranking"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_identify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Identify"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_games"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Games"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>