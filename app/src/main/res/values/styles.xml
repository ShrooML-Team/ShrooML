<resources>
    <style name="Theme.SplashBackground" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="BottomNavText" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

        <style name="Theme.Shrooml" parent="Theme.MaterialComponents.DayNight.NoActionBar">
            <item name="colorPrimary">#2D6A4F</item>
            <item name="colorPrimaryVariant">#1B4D3E</item>
            <item name="colorOnPrimary">#FFFFFF</item>
            <item name="colorSecondary">#FF6B6B</item>
            <item name="colorSecondaryVariant">#FF5252</item>
            <item name="colorOnSecondary">#FFFFFF</item>
            <item name="android:statusBarColor">#1B4D3E</item>
            <item name="android:windowBackground">#F8F9FA</item>
        </style>

        <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
            <item name="android:background">@drawable/button_primary_background</item>
            <item name="android:textColor">#FFFFFF</item>
            <item name="android:padding">12dp</item>
            <item name="android:textSize">14sp</item>
            <item name="cornerRadius">8dp</item>
        </style>

        <style name="ButtonSecondary" parent="Widget.MaterialComponents.Button">
            <item name="android:background">@drawable/button_secondary_background</item>
            <item name="android:textColor">#FFFFFF</item>
            <item name="android:padding">12dp</item>
            <item name="android:textSize">14sp</item>
            <item name="cornerRadius">8dp</item>
        </style>

        <style name="ButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
            <item name="android:textColor">#2D6A4F</item>
            <item name="strokeColor">#2D6A4F</item>
            <item name="cornerRadius">8dp</item>
        </style>

        <style name="SpinnerStyle">
            <item name="android:background">@drawable/bg_spinner</item>
            <item name="android:padding">12dp</item>
        </style>

        <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
            <item name="cardCornerRadius">16dp</item>
            <item name="cardElevation">4dp</item>
            <item name="cardBackgroundColor">#FFFFFF</item>
        </style>

</resources>