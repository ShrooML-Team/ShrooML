<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CreditScoringApp"
        tools:targetApi="31">

        <!-- SplashActivity - Activité de démarrage -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LoginActivity - Écran de connexion -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- RegisterActivity - Écran d'inscription -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- CustomerHomeActivity - Accueil client -->
        <activity
            android:name=".activities.CustomerHomeActivity"
            android:exported="false" />

        <!-- NewSimulationActivity - Nouvelle simulation -->
        <activity
            android:name=".activities.NewSimulationActivity"
            android:exported="false" />

        <!-- SimulationResultActivity - Résultat de simulation -->
        <activity
            android:name=".activities.SimulationResultActivity"
            android:exported="false" />

        <!-- TestActivity - Pour tester l'API -->
        <activity
            android:name=".activities.TestActivity"
            android:exported="true" />

    </application>

</manifest>